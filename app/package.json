{
  "name": "product-x",
  "productName": "Product X",
  "version": "0.1.0",
  "description": "An always-on-top AI learning companion and living spatial map of a medical student's education.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "electron:dev": "vite --mode electron",
    "electron:start": "vite build --mode electron && electron .",
    "electron:build": "vite build --mode electron && electron-builder"
  },
  "//build": [
    "electron-builder config. `electron:build` invoked electron-builder with NO build key at all,",
    "which fails immediately — so the packaging path had never once been exercised.",
    "`files` is an allowlist rather than a denylist: the repo carries _refs/, _vendor/, _shots/ and",
    "a large FBX animation pack, and a denylist would silently ship whichever of those someone adds",
    "next. asarUnpack covers the GLBs because three's loaders fetch them by URL, and a packed asar",
    "path is not fetchable."
  ],
  "build": {
    "appId": "dev.ahamdan.productx",
    "productName": "Product X",
    "directories": { "output": "release" },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "dist/**/*.glb",
      "dist/**/*.png"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Product X"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-static-copy": "^2.3.2",
    "vitest": "^2.1.5"
  }
}
